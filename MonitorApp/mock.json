{
  "Connections": [
    {
      "type": "sql",
      "name": "MockSQLConnection",
      "connectionString": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
    },
    {
      "type": "elastic",
      "name": "MockElasticConnection",
      "uri": "http://YOUR_ELASTICSEARCH_URI",
      "username": "YOUR_USERNAME",
      "password": "YOUR_PASSWORD"
    }
  ],
  "Queries": [
    {
      "type": "sql",
      "name": "MockQuery",
      "connection": "MockSQLConnection",
      "queryText": "SELECT LogID, LogText, CreatedAt FROM MockTable",
      "notifications": [
        {
          "type": "email",
          "name": "MockGroupedEmailNotification",
          "smtpServer": "YOUR_SMTP_SERVER",
          "smtpPort": "587",
          "username": "YOUR_EMAIL_USERNAME",
          "password": "YOUR_EMAIL_PASSWORD",
          "fromEmail": "from@example.com",
          "toEmail": "to@example.com",
          "subject": "Mock Grouped Log Report (Email)",
          "useSsl": "true",
          "format": "xml",
          "notificationText": "<head><h1>Grouped Log Report by Message</h1></head><group by=\"LogText\"><header><h2>Message: \"{LogText}\"</h2><table border=\"1\" style=\"width:100%; border-collapse: collapse; margin-bottom: 10px;\"><thead style=\"background-color:#f2f2f2;\"><tr style=\"background-color:#f2f2f2;\"><th style=\"padding: 8px; text-align: left;\">Log ID</th><th style=\"padding: 8px; text-align: left;\">Created At</th></tr></thead><tbody></header><item><tr><td style=\"padding: 8px; border-bottom: 1px solid #ddd;\">{LogID}</td><td style=\"padding: 8px; border-bottom: 1px solid #ddd;\">{CreatedAt}</td></tr></item><footer></tbody></table><p><i>--- End of group for \"{LogText}\" ---</i></p></footer></group><footer><hr/><p><b>End of Full Report</b></p></footer>"
        },
        {
          "type": "teams",
          "name": "MockGroupedTeamsNotification",
          "webhookUrl": "YOUR_TEAMS_WEBHOOK_URL",
          "format": "xml",
          "notificationText": "<head># Grouped Log Report</head><group by=\"LogText\"><header>## Log Message: {LogText}</header><item>* ID: {LogID} (Created: {CreatedAt})</item><footer>---</footer></group><footer>End of Report</footer>"
        },
        {
          "type": "sms",
          "name": "MockSmsNotification",
          "apiUrl": "YOUR_SMS_API_URL",
          "accountSid": "YOUR_SMS_ACCOUNT_SID",
          "authToken": "YOUR_SMS_AUTH_TOKEN",
          "fromNumber": "+1234567890",
          "toNumber": "+1987654321",
          "notificationText": "Log: {LogID} - {LogText}"
        }
      ]
    },
    {
      "type": "inFile",
      "name": "MockInFile",
      "path": "mock_sql_selects.json"
    },
    {
      "type": "elastic",
      "name": "MockESQueryNoNotifications",
      "connection": "MockElasticConnection",
      "index": "mock-index",
      "queryText": "{\\\"query\\\":{\\\"match_all\\\":{}}}",
      "notifications": []
    }
  ]
}
{
  "Connections": [
    {
      "type": "elastic",
      "name": "MockElastic",
      "uri": "http://localhost:9200",
      "username": "elastic",
      "password": "changeme"
    }
  ],
  "Queries": [
    {
      "type": "elastic",
      "name": "ES_Teams_Raw_Markdown",
      "connection": "MockElastic",
      "index": "logs",
      "queryText": "{\"query\":{\"match\":{\"level\":\"error\"}}}",
      "notifications": [
        {
          "type": "teams",
          "name": "TeamsRawMarkdown",
          "webhookUrl": "https://outlook.office.com/webhook/...",
          "notificationBody": {
            "body": "## Error in {service.name}!\n\n**Message**: {error.message}\n\nThis will be repeated for every row."
          }
        }
      ]
    },
    {
      "type": "elastic",
      "name": "ES_Teams_XML_Simple_HBF",
      "connection": "MockElastic",
      "index": "logs",
      "queryText": "{\"query\":{\"match\":{\"level\":\"error\"}}}",
      "notifications": [
        {
          "type": "teams",
          "name": "TeamsSimpleHBF",
          "webhookUrl": "https://outlook.office.com/webhook/...",
          "notificationBody": {
            "head": "# Static Header",
            "body": "This is a static body, it will appear only once.",
            "foot": "---\nStatic Footer"
          }
        }
      ]
    },
    {
      "type": "elastic",
      "name": "ES_Teams_Placeholders",
      "connection": "MockElastic",
      "index": "logs",
      "queryText": "{\"query\":{\"match\":{\"level\":\"error\"}}}",
      "notifications": [
        {
          "type": "teams",
          "name": "TeamsPlaceholders",
          "webhookUrl": "https://outlook.office.com/webhook/...",
          "notificationBody": {
            "body": "## Alert for {service.name}\n**Message**: {error.message}"
          }
        }
      ]
    },
    {
      "type": "elastic",
      "name": "ES_Teams_Counters",
      "connection": "MockElastic",
      "index": "logs",
      "queryText": "{\"query\":{\"match\":{\"level\":\"error\"}}}",
      "notifications": [
        {
          "type": "teams",
          "name": "TeamsCounters",
          "webhookUrl": "https://outlook.office.com/webhook/...",
          "notificationBody": {
            "head": "# Total errors: {global.count}",
            "body": "- Error message: {error.message}"
          }
        }
      ]
    },
    {
      "type": "elastic",
      "name": "ES_Teams_Grouping",
      "connection": "MockElastic",
      "index": "logs",
      "queryText": "{\"query\":{\"match\":{\"level\":\"error\"}}}",
      "notifications": [
        {
          "type": "teams",
          "name": "TeamsGrouping",
          "webhookUrl": "https://outlook.office.com/webhook/...",
          "notificationBody": {
            "head": "# Grouped Error Report",
            "groupBy": "service.name",
            "groupHead": "## Service: {service.name} ({group.count} errors)",
            "body": "- {error.message} at {@timestamp}",
            "groupFoot": "---",
            "foot": "End of report"
          }
        }
      ]
    }
  ]
}
